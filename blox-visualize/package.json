{
  "name": "blox-visualize",
  "version": "0.1.1",
  "description": "Drop-in trading panels: market chart, order book, depth, tape, order entry, orders, PnL.",
  "type": "module",
  "license": "MIT",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": "./dist/index.js",
    "./panels/*": "./dist/panels/*.js",
    "./feed": "./dist/feed.js",
    "./mock": "./dist/mock.js",
    "./format": "./dist/format.js",
    "./panel": "./dist/panel.js",
    "./style.css": "./src/style.css"
  },
  "files": [
    "dist",
    "!dist/__checks__",
    "src/style.css"
  ],
  "peerDependencies": {
    "lightweight-charts": "^4"
  },
  "peerDependenciesMeta": {
    "lightweight-charts": {
      "optional": true
    }
  },
  "scripts": {
    "build": "tsc",
    "check": "tsc && node dist/__checks__/check.js",
    "build:demo": "tsc && rm -rf static/lib && cp -r dist static/lib && rm -rf static/lib/__checks__ && cp src/style.css static/style.css"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "typescript": "^5.6.0"
  }
}
